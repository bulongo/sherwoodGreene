.nav {
  position: fixed;
  top: 0;
  border: solid var(--primary) 1px;
  box-shadow: 0px 37px 21px -24px rgba(0,0,0,0.1);
  /* margin-top: 1rem; */
  display: flex;
  justify-content: space-between;
  /* align-items: center; */
  width: 100%;
  height: 8vh;
  background: blue;

  .logo {
    font-size: 6.5rem;
    height: 5vh;
    transform: scale(.7);


    .sherwood {
      position: absolute;
      top: -25px;
      left: -15px;
      /* font-size: 5rem; */
    }

    .greene {
      position: absolute;
      top: 5px;
      transform: scale(0.85);
    }

    .lower {
      /* display: inline-block; */
      font-size: 1.3rem;
      color: #bbb;
      /* margin-bottom: 1rem; */
      /* border: solid brown; */
    }
  }

  .burger {
    position: absolute;
    border: none;
    width: 35px;
    height: 25px;
    display: flex;
    justify-content: space-around;
    align-items: flex-start;
    background: transparent;
    flex-direction: column;
    
    span {
      display: block;
      width: 35px;
      /* border: solid blue; */
      height: 1px;
    }

    .top,.bottom {
      border: solid white 1px;
    }

    .bottom {
      width: 25px;
    }
  }

  .navList {
    display: flex;
    transform: translateX(300px);
  }

  .navList.active {
    transform: translateX(0);
    display: none;
    flex-direction: column;
    justify-content: space-around;
    /* border: solid green; */
    /* height: 100vh; */
    width: 100%;
    background: blue;
    
    li {
      list-style: none;
      padding: .2rem;
      z-index: 5;
      border: solid white 1px;
      text-align: center;
      font-size: 1.4rem;


      a {
        color: white;
        text-decoration: none;
      }

      &.active {
        border-left: solid rgba(216, 60, 0, 0.7) 1px;
        border-right: solid rgba(216, 60, 0, 0.7) 1px;
        background: rgba(216, 60, 0, 0.5);
        /* background: orangered; */
      }
    }
  }
}
